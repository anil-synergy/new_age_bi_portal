{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowAllOrigins": [
    "http://localhost:3000"
  ],
  "Serilog": {
    "Using": [ "Serilog.Sinks.PostgreSQL" ],
    "MinimumLevel": "Information",
    "WriteTo": [

      {
        "Name": "PostgreSQL",
        "Args": {
          //"connectionString": "Host=192.168.2.98;Port=5432;Database=bi_report;Username=postgres;Password=Think@123;",

          "tableName": "logs",
          "schemaName": "public",
          "needAutoCreateTable": true,
          "batchPostingLimit": 1
        }
      }
    ]
  },
  "AuthConfiguration": {
    "Authority": "https://login-shore-develop.synergymarinetest.com",
    "RequireHttps": false,
    "AuthoritySeafarer": "https://login-seafarer-develop.synergymarinetest.com",
    "AuthorityShore": "https://login-shore-develop.synergymarinetest.com"
  },
  "SystemAdminRoleName": "System Admin"
}
