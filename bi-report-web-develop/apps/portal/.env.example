# Auth — true = Microsoft SSO (DATA360-style app JWT)
NEXT_PUBLIC_AUTH_ENABLED=true

# Microsoft Entra ID — public (browser)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=71ff9a70-b839-4527-b452-fa7883b42ff4
NEXT_PUBLIC_MICROSOFT_TENANT_ID=5847cf3f-db1f-4d01-abcf-cbff4bdffc2d
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback

# Microsoft Entra ID — server only (never NEXT_PUBLIC_)
MICROSOFT_CLIENT_ID=71ff9a70-b839-4527-b452-fa7883b42ff4
MICROSOFT_TENANT_ID=5847cf3f-db1f-4d01-abcf-cbff4bdffc2d
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback
MICROSOFT_CLIENT_SECRET=

# App JWT (must match bi-report-api / DATA360 validation)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
SSO_SESSION_TIMEOUT_HOURS=8

# API — local PowerBI.Api. Remote fallback: https://api-dev.synergymarinetest.com
# Local restore needs NUGET_SECRET in bi-report-api .env.local (never commit it).
NEXT_PUBLIC_BI_API_BASE=http://localhost:5074
BI_API_BASE=http://localhost:5074
NEXT_PUBLIC_AZURE_FUNCTION_BASE=https://hawkeye-sp-wrtb-func.azurewebsites.net/api
# Server-side embed (preferred). Browser calls /api/embed/*, which uses this.
AZURE_FUNCTION_BASE=https://hawkeye-sp-wrtb-func.azurewebsites.net/api
# BI_Portal_Auth function key (server-only; from Azure Portal → Function → App keys)
AZURE_FUNCTION_CODE=
# Optional HTTP trigger name (default BI_Portal_Auth)
# AZURE_EMBED_FUNCTION_PATH=BI_Portal_Auth
# Fallback username only when session UPN cannot be resolved (Hawkeye embed SP App ID; not object ID).
PBI_EMBED_SP_CLIENT_ID=7c79b1ca-ef70-493c-923b-2965469b1c40
# Comma-separated dataset GUIDs that need workspace-identity embed (SP app id + effectiveIdentity.datasets, roles [])
# PBI_WORKSPACE_IDENTITY_DATASET_IDS=2e33f17a-0b33-4d3a-9441-69ed9aebc017
# Hawkeye SP credentials belong on the Function App only (PBI_CLIENT_ID / PBI_CLIENT_SECRET).

# Portal catalog PostgreSQL (password defaults from bi-report-api appsettings unless overridden)
# BI_API_APPSETTINGS=<path-to>\bi-report-api\PowerBi\PowerBI.Api\appsettings.staging.json
# BI_REPORT_DB_CONNECTION=Host=...;Port=5432;Database=synergy_bi_reports;Username=bi_user;Password=...;SSL Mode=Require;Trust Server Certificate=true
# QA:
# BI_REPORT_DB_HOST=biportaldev.c5nsyns7onlz.ap-south-1.rds.amazonaws.com
# Staging:
# BI_REPORT_DB_HOST=biportaldev.c5nsyns7onlz.ap-south-1.rds.amazonaws.com
# BI_REPORT_DB_PORT=5432
# BI_REPORT_DB_NAME=synergy_bi_reports
# BI_REPORT_DB_USER=BI_USER
# BI_REPORT_DB_PASSWORD=

# Fabric Rayfin report provider (browser; IDs and URLs only, no secrets).
# CLIENT_ID is an Entra app with a "Single-page application" redirect URI equal to REDIRECT_URI
# and delegated consent for SCOPES. TENANT_ID falls back to NEXT_PUBLIC_MICROSOFT_TENANT_ID.
# REDIRECT_URI defaults to <origin>/dashboard/apps/fabric-rayfin (portal MSAL landing; rayfin_embed_test uses bare origin on its dev port).
NEXT_PUBLIC_RAYFIN_TENANT_ID=5847cf3f-db1f-4d01-abcf-cbff4bdffc2d
NEXT_PUBLIC_RAYFIN_CLIENT_ID=
NEXT_PUBLIC_RAYFIN_REDIRECT_URI=http://localhost:3000/dashboard/apps/fabric-rayfin
NEXT_PUBLIC_RAYFIN_SCOPES=https://analysis.windows.net/powerbi/api/Item.Execute.All
NEXT_PUBLIC_RAYFIN_WORKSPACE_ID=
NEXT_PUBLIC_RAYFIN_APP_ID=
NEXT_PUBLIC_RAYFIN_APP_URL=

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5

# SMART multi-agent orchestrator (server-side only; see src/modules/smart-chatbot/agents/README.md)
SMART_ORCHESTRATOR_URL=http://127.0.0.1:8100
# Must equal PORTAL_JWT_SECRET in agents/smart_orchestrator/.env (may match JWT_SECRET in dev only)
SMART_ORCHESTRATOR_SECRET=

# Power BI service principal for SemantIQ (Power BI REST executeQueries; not Graph API)
SMART_PBI_TENANT_ID=
SMART_PBI_CLIENT_ID=
SMART_PBI_CLIENT_SECRET=
