# N.O.V.A. (pbi_nova_visual_generator) - copy to .env and fill in. .env is git-ignored.

HOST=127.0.0.1
PORT=8102
LOG_LEVEL=INFO
# Same value as MCP_SHARED_SECRET in smart_orchestrator/.env.
MCP_SHARED_SECRET=<random-secret>
NOVA_MAX_POINTS=50

# --- LLM gateway (chart-type selection only; numbers always come from data) ---
LLM_BASE_URL=https://aigw.synergymarinegroup.com
LLM_API_KEY=<from secret store>
LLM_DEPLOYMENT=azure_ai/gpt-5.6-luna
LLM_TIMEOUT_S=45
LLM_MAX_CONCURRENCY=8
