# SemantIQ (pbi_semantiq_agent) - copy to .env and fill in. .env is git-ignored.
# Real environment variables override values in this file.

# --- Service ---
HOST=127.0.0.1
PORT=8101
LOG_LEVEL=INFO
# Same value as MCP_SHARED_SECRET in smart_orchestrator/.env (long random string).
MCP_SHARED_SECRET=<random-secret>

# --- Power BI service principal (Power BI REST API, not Microsoft Graph) ---
PBI_TENANT_ID=<tenant-guid>
PBI_CLIENT_ID=<app-registration-client-id>
PBI_CLIENT_SECRET=<from secret store>
# Optional: when all three FABRIC_* values are set they override PBI_* (e.g. APP-SynergyFabric-OAuth).
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
PBI_SCOPE=https://analysis.windows.net/powerbi/api/.default
PBI_API_BASE=https://api.powerbi.com/v1.0/myorg
# Comma-separated workspace (group) ids SemantIQ may read. Empty = every workspace the principal can see.
PBI_ALLOWED_WORKSPACE_IDS=
PBI_MAX_ROWS=500
PBI_MAX_CONCURRENCY=8
PBI_TIMEOUT_S=60
METADATA_CACHE_TTL_S=900
METADATA_CACHE_MAX_ENTRIES=1024
INDEX_METADATA_CONCURRENCY=3

# --- Portal catalog DB (build_semantic_metadata only; same vars as apps/portal .env.local) ---
# BI_REPORT_DB_HOST=
# BI_REPORT_DB_PORT=5432
# BI_REPORT_DB_NAME=synergy_bi_reports
# BI_REPORT_DB_USER=
# BI_REPORT_DB_PASSWORD=
# Or: BI_REPORT_DB_CONNECTION=Host=...;Port=5432;Database=...;Username=...;Password=...

# --- Keyword index (offline indexer -> Qdrant; chat uses one targeted DAX) ---
# Run daily or after a model refresh:  pbi-index-keywords   (add --dataset <id> to index one model)
# Local Qdrant (no API key):  docker run -d --name qdrant -p 6333:6333 -v qdrant_data:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://127.0.0.1:6333
# Leave empty for local Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=smart_keywords
# Free local embedding model (fastembed). Fallback is used if the first cannot be loaded.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_CACHE_DIR=.data/fastembed
EMBEDDING_DIMENSIONS=384
KEYWORD_ROUTER_ENABLED=true
KEYWORD_ROUTER_MIN_SCORE=0.55

# --- Automatic metadata refresh ---
# Seconds between background syncs (portal catalogue, workspace inventory, model schemas, ontology bindings). 0 disables.
METADATA_SYNC_INTERVAL_S=3600
# Delay before the first background sync after start.
METADATA_SYNC_STARTUP_DELAY_S=60
# Portal menu catalogue from the Next route GET /api/smart/catalog (service JWT, audience bi-portal-catalog).
# Falls back to the BI_REPORT_DB_* Postgres read above when unset or unreachable.
PORTAL_CATALOG_URL=http://127.0.0.1:3000
# Same value as SMART_ORCHESTRATOR_SECRET in apps/portal/.env.local (falls back to that env var if unset).
PORTAL_CATALOG_SECRET=<random-secret>
# Regenerate concept_bindings.auto.jsonl from extracted models; refresh semantic_model_catalog.jsonl from Power BI.
ONTOLOGY_AUTO_BINDINGS=true
INVENTORY_SYNC_ENABLED=true
# Writable folder for generated JSONL (share between processes in split deployments).
# PBI_METADATA_ROOT=

# --- Optional Microsoft Graph app (reserved, not used yet) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- LLM gateway (DAX planning) ---
LLM_BASE_URL=https://aigw.synergymarinegroup.com
LLM_API_KEY=<from secret store>
LLM_DEPLOYMENT=azure_ai/gpt-5.6-luna
LLM_TIMEOUT_S=60
LLM_MAX_CONCURRENCY=8
