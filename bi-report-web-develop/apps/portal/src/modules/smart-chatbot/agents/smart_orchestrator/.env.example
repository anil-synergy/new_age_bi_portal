# SMART orchestrator - copy to .env and fill in. .env is git-ignored.

HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO

# Shared with the portal (SMART_ORCHESTRATOR_SECRET in apps/portal/.env.local).
# The portal signs a short-lived HS256 token with it after verifying the user's Entra session.
PORTAL_JWT_SECRET=<random-secret>
# Shared with SemantIQ and N.O.V.A. (their MCP_SHARED_SECRET).
MCP_SHARED_SECRET=<random-secret>
ALLOWED_ORIGINS=http://localhost:3000

# Agent registry (MCP streamable-HTTP endpoints). Extra agents: AGENT_REGISTRY={"agent_id":"http://host:port/mcp"}
SEMANTIQ_MCP_URL=http://127.0.0.1:8100/mcp/semantiq/mcp
NOVA_MCP_URL=http://127.0.0.1:8100/mcp/nova/mcp
AGENT_REGISTRY={}

# Answer gating and load limits
CONFIDENCE_THRESHOLD=0.98
MAX_CONCURRENT_REQUESTS=32
USER_REQUESTS_PER_MINUTE=20
REQUEST_TIMEOUT_S=120

# --- LLM gateway (intent, wording of summaries) ---
LLM_BASE_URL=https://aigw.synergymarinegroup.com
LLM_API_KEY=<from secret store>
LLM_DEPLOYMENT=azure_ai/gpt-5.6-luna
LLM_TIMEOUT_S=60
LLM_MAX_CONCURRENCY=16

# --- Hybrid retrieval (see RETRIEVAL.md) ---
# Embeddings: empty = local hashing embedder. Set to a gateway embedding deployment the key may call.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_S=15
# Pinecone serverless index (metric cosine, dimension = EMBEDDING_DIMENSIONS). Empty = in-process vectors.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=smart-catalog
PINECONE_API_VERSION=2025-04
PINECONE_TIMEOUT_S=10
RETRIEVAL_VECTOR_WEIGHT=0.55
RETRIEVAL_BM25_WEIGHT=0.45
RETRIEVAL_TOP_K=12
RERANK_HYBRID_WEIGHT=0.5
RERANK_TITLE_WEIGHT=0.35
RERANK_MENU_WEIGHT=0.1
RERANK_MARKER_WEIGHT=0.05
RETRIEVAL_VECTOR_FLOOR=0.35
RETRIEVAL_SELECT_THRESHOLD=0.55
RETRIEVAL_SELECT_MARGIN=0.12
RETRIEVAL_MIN_RELEVANCE=0.2
RETRIEVAL_MAX_OPTIONS=4
# Background indexing of table/column/measure names via SemantIQ get_model_schema
INDEX_MODEL_METADATA=true
INDEX_METADATA_CONCURRENCY=3
INDEX_METADATA_MAX_MODELS=0
INDEX_METADATA_TTL_S=3600
# Empty = smart_orchestrator/knowledge/glossary.json
GLOSSARY_PATH=

# --- PROD / DEV / ARCHIVE hard filter ---
REPORT_ENV_DEV_TERMS=draft,test,testing,tst,dev,development,uat,sandbox,staging,poc,wip,temp,tmp,sample,copy
REPORT_ENV_ARCHIVE_TERMS=archive,archived,backup,bkp,bak,old,deprecated,legacy,obsolete
# Words that unlock DEV/ARCHIVE in a question only next to report/model words or a matching model name
REPORT_ENV_QUERY_WEAK_TERMS=draft,test,testing,old,legacy,copy,sample,temp,tmp,obsolete
# Business phrases that contain a marker word but are production subjects
REPORT_ENV_PROD_PHRASES=draft survey,draft reading,draft readings,draft marks,vessel draft,arrival draft,departure draft,drug test,alcohol test,test result,test results
# JSON map of dataset id, report id or exact title -> PROD|DEV|ARCHIVE (reviewed exceptions)
REPORT_ENV_OVERRIDES={}
REPORT_ENV_CLASSIFY_WORKSPACE=true
# Comma-separated emails allowed to send include_nonprod=true
NONPROD_OVERRIDE_USERS=

# --- Semantic cache ---
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_S=900
SEMANTIC_CACHE_UNKNOWN_FRESHNESS_TTL_S=120
SEMANTIC_CACHE_SIMILARITY=0.92
SEMANTIC_CACHE_MAX_ENTRIES=2000
FRESHNESS_TTL_S=60

# --- Conversation state ---
PENDING_TTL_S=900
MAX_CLARIFICATIONS=2
# Durable checkpoints need: pip install langgraph-checkpoint-sqlite
CHECKPOINT_SQLITE_PATH=

# --- Feedback and failure analytics ---
ANALYTICS_DB_PATH=.data/smart_analytics.db
REPEAT_SIMILARITY=0.6
REPEAT_WINDOW=6
